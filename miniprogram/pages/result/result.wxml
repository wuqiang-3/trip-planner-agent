<view wx:if="{{ plan }}" class="page">
  <view class="header">
    <text class="title">{{ plan.city }}</text>
    <text class="subtitle">{{ plan.start_date }} ~ {{ plan.end_date }} · {{ plan.days.length }}日游</text>
    <view wx:if="{{ plan.budget }}" class="budget">预算合计 ¥{{ plan.budget.total }}</view>
  </view>

  <day-card
    wx:for="{{ plan.days }}"
    wx:key="date"
    day="{{ item }}"
    index="{{ index }}"
    weather="{{ weatherMap[item.date] }}"
  />

  <view wx:if="{{ plan.overall_suggestions }}" class="suggest">
    <text class="suggest-title">💡 总体建议</text>
    <text class="suggest-body">{{ plan.overall_suggestions }}</text>
  </view>

  <view class="btn-group">
    <button class="share-btn" open-type="share">分享给好友</button>
    <button class="image-btn" bindtap="onGenerateImage">📷 生成长图</button>
  </view>
</view>

<!-- 隐藏 Canvas（用于生成长图） -->
<canvas type="2d" id="trip-canvas" class="hidden-canvas"></canvas>

<!-- 长图预览弹窗 -->
<view wx:if="{{ showPreview }}" class="preview-mask" bindtap="onClosePreview">
  <view class="preview-box" catchtap="stopPropagation">
    <scroll-view scroll-y class="preview-scroll">
      <image src="{{ previewImage }}" mode="widthFix" class="preview-img" />
    </scroll-view>
    <view class="preview-actions">
      <button class="save-btn" bindtap="onSaveImage">💾 保存到相册</button>
      <button class="close-btn" bindtap="onClosePreview">关闭</button>
    </view>
  </view>
</view>
